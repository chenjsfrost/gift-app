# Copy to .env and fill in. .env is never committed.

# Web server (local only)
PORT=3000

# Claude, for type-to-log and the eval
ANTHROPIC_API_KEY=

# Reminder email (Gmail: create an app password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
REMIND_TO=
# How many days ahead the reminder looks
REMIND_DAYS=30
